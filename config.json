{
  "dataset": {
    "num_cases": 75,
    "output_path": "data/judicial_cases.csv",
    "min_year": 2015,
    "max_year": 2024
  },
  "preprocessing": {
    "remove_special_chars": true,
    "lowercase": true,
    "remove_stopwords": true,
    "min_token_length": 3
  },
  "embeddings": {
    "method": "tfidf",
    "max_features": 384,
    "model_name": "bert-base-uncased",
    "min_df": 1,
    "max_df": 0.9
  },
  "similarity_search": {
    "method": "faiss",
    "metric": "l2",
    "k_similar_cases": 3,
    "fallback_method": "cosine"
  },
  "prediction": {
    "model": "random_forest",
    "n_estimators": 50,
    "max_depth": 10,
    "random_state": 42,
    "test_size": 0.2
  },
  "bias_detection": {
    "analyze_demographic": true,
    "analyze_temporal": true,
    "analyze_procedural": true,
    "regions": ["North", "South", "East", "West", "Central", "Northeast", "Southeast", "Midwest"]
  },
  "neo4j": {
    "enabled": false,
    "uri": "bolt://localhost:7687",
    "username": "neo4j",
    "password": "password",
    "offline_mode": true
  },
  "output": {
    "generate_html": true,
    "generate_json": true,
    "generate_csv": true,
    "output_dir": "output",
    "report_title": "Judicial AI System - Demo Report"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/system.log"
  },
  "performance": {
    "enable_caching": true,
    "cache_embeddings": true,
    "cache_predictions": false,
    "batch_size": 32
  }
}
